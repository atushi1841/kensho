# ── Kensho .gitignore ──
# セキュリティ: Xアカウント認証情報
data/x_session*.json
data/session_backup/
data/backups/

# セキュリティ: ポイントサイト認証情報
.env.pointsites*
.env
*.env

# ランタイムデータ（git管理不要）
data/collected.json
data/processed.json
data/prizes.json
data/wins.json
data/account_health.json
data/follow_state.json
data/locks/
data/archive/
data/daily_counts.json
data/orchestrator_state.json
data/orchestrator_heartbeat.json
data/follow_lock.json
data/crash_reports/
accounts.db

# 巨大Chromeプロファイル（デバッグ用）
chrome_profile/
tmp_profile/

# ビルド・キャッシュ
__pycache__/
.coverage
*.pyc
*.pyo
*.pyd
*.pyc
*.egg-info/

# ログ
logs/
*.log

# 実行時生成ファイル
output*.txt
run_output*.txt
nul
moppy_test.txt

# OSゴミ
Thumbs.db
.DS_Store
desktop.ini
*.swp

# その他
.hermes/
hermes_agent.log
.venv/
scripts/claude-flash
scripts/claude-pro
wiki/
.aider*

# ランタイム生成データ（git管理不要）
data/audit.jsonl
data/crash_history.json
data/dashboard.html
data/discovered_accounts.json
data/profiles/
data/*.bak.*
data/*.bak
data/kensho_hub.html
data/.audit_bot_safety_state.json
kensho-status.html
.supermemory/

# ── 未追跡データ（コミット対象外）──
# 別プロジェクト(Reddit自動投稿)のデータ。cookie含むため絶対コミット禁止
crontab_pre_ab.bak
data/reddit/
# 需要調査の一時データ
demand_research.json

# VirtualBox VM（誤配置防止）
VirtualBox VMs/

# Windowsショートカット
scripts/*.lnk

# kensho/tools配下のサードパーティバイナリ
kensho/tools/3proxy*
kensho/tools/ForceBindIP*
kensho/tools/*.zip
kensho/tools/kudou_RM10JE_B
kensho/tools/繧*

# kensho/配下のランタイムデータ
kensho/data/
kensho/application/transaction_pairs.json
.hermes_backup_rtfix/
data/*.bak_*
