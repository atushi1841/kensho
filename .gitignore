.supermemory/

# ── 未追跡データ（コミット対象外）──
# 別プロジェクト(Reddit自動投稿)のデータ。cookie含むため絶対コミット禁止
crontab_pre_ab.bak
data/reddit/
# 需要調査の一時データ
demand_research.json

# VirtualBox VM（誤配置防止）
VirtualBox VMs/

# Windowsショートカット
scripts/*.lnk

# kensho/tools配下のサードパーティバイナリ
kensho/tools/3proxy*
kensho/tools/ForceBindIP*
