{
  "title": "Figure Price Results",
  "description": "Paginated list of anime figure price data items with offers",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "figureId": {
            "type": "string",
            "title": "Figure ID",
            "template": "{{figureId}}"
          },
          "sourceUrl": {
            "type": "string",
            "title": "Source URL",
            "template": "{{sourceUrl}}"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "template": "{{name}}"
          },
          "series": {
            "type": "string",
            "title": "Series",
            "template": "{{series}}"
          },
          "character": {
            "type": "string",
            "title": "Character",
            "template": "{{character}}"
          },
          "manufacturer": {
            "type": "string",
            "title": "Manufacturer",
            "template": "{{manufacturer}}"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "template": "{{category}}"
          },
          "releaseDate": {
            "type": "string",
            "title": "Release Date",
            "template": "{{releaseDate}}"
          },
          "scale": {
            "type": "string",
            "title": "Scale",
            "template": "{{scale}}"
          },
          "sculptor": {
            "type": "string",
            "title": "Sculptor",
            "template": "{{sculptor}}"
          },
          "heightCm": {
            "type": "number",
            "title": "Height (cm)",
            "template": "{{heightCm}}"
          },
          "janCode": {
            "type": "string",
            "title": "JAN Code",
            "template": "{{janCode}}"
          },
          "imageUrl": {
            "type": "string",
            "title": "Image URL",
            "template": "{{imageUrl}}"
          },
          "offers": {
            "type": "array",
            "title": "Offers",
            "items": {
              "type": "object",
              "properties": {
                "shopName": {
                  "type": "string",
                  "title": "Shop Name",
                  "template": "{{shopName}}"
                },
                "priceJpy": {
                  "type": "integer",
                  "title": "Price (JPY)",
                  "template": "{{priceJpy}}"
                },
                "availability": {
                  "type": "string",
                  "title": "Availability",
                  "template": "{{availability}}"
                },
                "url": {
                  "type": "string",
                  "title": "URL",
                  "template": "{{url}}"
                },
                "condition": {
                  "type": "string",
                  "title": "Condition",
                  "template": "{{condition}}"
                },
                "fetchedAt": {
                  "type": "string",
                  "title": "Fetched At",
                  "template": "{{fetchedAt}}"
                }
              }
            }
          },
          "msrpJpy": {
            "type": "integer",
            "title": "MSRP (JPY)",
            "template": "{{msrpJpy}}"
          },
          "lowestPriceJpy": {
            "type": "integer",
            "title": "Lowest Price (JPY)",
            "template": "{{lowestPriceJpy}}"
          },
          "highestPriceJpy": {
            "type": "integer",
            "title": "Highest Price (JPY)",
            "template": "{{highestPriceJpy}}"
          },
          "inStockCount": {
            "type": "integer",
            "title": "In Stock Count",
            "template": "{{inStockCount}}"
          },
          "totalOffersCount": {
            "type": "integer",
            "title": "Total Offers Count",
            "template": "{{totalOffersCount}}"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence",
            "template": "{{confidence}}"
          },
          "sourcesMerged": {
            "type": "array",
            "title": "Sources Merged",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "total": {
      "type": "integer",
      "title": "Total",
      "template": "{{total}}"
    },
    "limit": {
      "type": "integer",
      "title": "Limit",
      "template": "{{limit}}"
    },
    "offset": {
      "type": "integer",
      "title": "Offset",
      "template": "{{offset}}"
    }
  },
  "actorOutputSchemaVersion": 1,
  "required": [
    "items",
    "total"
  ]
}