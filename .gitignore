data/orchestrator_heartbeat.json
data/follow_lock.json
data/crash_reports/
data/fixupx_guard.json
data/dead_source_state.json
accounts.db

# 巨大Chromeプロファイル（デバッグ用）
chrome_profile/
tmp_profile/

# ビルド・キャッシュ
__pycache__/
.coverage
*.pyc
*.pyo
*.pyd
*.pyc
*.egg-info/

# ログ
logs/
*.log

# 実行時生成ファイル
output*.txt
run_output*.txt
nul
moppy_test.txt

# OSゴミ
Thumbs.db
.DS_Store
desktop.ini
*.swp

# その他
.hermes/
hermes_agent.log
.venv/
scripts/claude-flash
scripts/claude-pro
wiki/
.aider*

